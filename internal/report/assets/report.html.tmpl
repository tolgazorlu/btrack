<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root { color-scheme: light; }
  body { margin: 0; }
  img { max-width: 100%; }
  [hidden] { display: none !important; }
</style>
<title>{{ .Title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap">
<style>
{{ .CSS }}
</style>
</head>
<body>
<div class="sheet">

  <header class="masthead">
    <div class="masthead-rule"></div>
    <p class="eyebrow">{{ .Client }} · Serbest çalışma dökümü</p>
    <h1>{{ .Range }} geliştirme raporu</h1>
    <p class="standfirst">
      İki bölümden oluşur: <strong>yapılan iş dökümü</strong> — <code>main</code> dalına birleştirilen
      tüm çalışmalar gün gün ve commit bazında — ve <strong>çalışma saatleri</strong> — aynı dönemin
      kronometre kayıtları. Kaynak: proje git geçmişi ve tutulan süre kaydı.
    </p>
    <p class="docmeta">
      <span>Rapor no <b>{{ .DocRef }}</b></span>
      <span>Düzenleme <b>{{ .GeneratedAt.Format "02.01.2006" }}</b></span>
      <span>Dönem <b>{{ .ShortRange }}</b></span>
      {{ with .PreparedBy }}<span>Hazırlayan <b>{{ . }}</b></span>{{ end }}
    </p>
  </header>

  <dl class="figures">
    <div class="figure lead">
      <dt>Kayıtlı süre</dt>
      <dd>{{ .TotalDecimal }} sa<small>{{ .TotalLabel }}</small></dd>
    </div>
    <div class="figure">
      <dt>Commit</dt>
      <dd>{{ .TotalCommits }}<small>birleştirme hariç</small></dd>
    </div>
    {{ if .PRCount }}
    <div class="figure">
      <dt>Pull request</dt>
      <dd>{{ .PRCount }}<small>{{ .PRSpan }}</small></dd>
    </div>
    {{ end }}
    <div class="figure">
      <dt>Çalışma günü</dt>
      <dd>{{ .WorkedDays }}<small>{{ .ShortRange }}</small></dd>
    </div>
    {{ if .FilesChanged }}
    <div class="figure">
      <dt>Değişen dosya</dt>
      <dd>{{ .FilesChanged }}<small>+{{ thousands .LinesAdded }} / −{{ thousands .LinesRemoved }} satır</small></dd>
    </div>
    {{ end }}
  </dl>

  <div class="part first">
    <h2>Bölüm 1 — Yapılan iş dökümü</h2>
    <span class="part-sub">main dalı · {{ .TotalCommits }} commit{{ if .PRCount }} · {{ .PRCount }} pull request{{ end }}</span>
  </div>

  <div class="legend">
    <span><span class="tag tag-feat">feat</span> yeni özellik</span>
    <span><span class="tag tag-fix">fix</span> hata düzeltme</span>
    <span><span class="tag tag-chore">bakım</span> yeniden düzenleme / biçim / altyapı</span>
    <span><span class="tag tag-revert">geri al</span> sonradan geri alınan çalışma</span>
  </div>

  {{ range .CommitDays }}
  <section class="day">
    <div class="day-head">
      <p class="day-date">{{ .FormatDate }}</p>
      <p class="day-weekday">{{ .Weekday }}</p>
      {{ with .Areas }}<p class="day-areas">{{ . }}</p>{{ end }}
      <p class="day-count">{{ .CommitCount }}</p>
    </div>
    <div class="entries">
      {{ range .Commits }}
      <div class="entry{{ if eq .Kind "revert" }} reverted{{ end }}">
        <span class="tag {{ .Kind.CSSClass }}">{{ .Kind.Label }}</span>
        <div class="entry-text">
          <p>{{ .Subject }}</p>
          <p class="entry-meta">{{ .ShortSHA }}{{ if .PR }} · <span class="pr">PR #{{ .PR }}</span>{{ end }}{{ with join .Areas ", " }} · {{ . }}{{ end }}</p>
        </div>
      </div>
      {{ end }}
    </div>
  </section>
  {{ end }}

  {{ if .Pending }}
  <div class="pending">
    <h2>Açık talepler</h2>
    <p class="note">Dönem içinde iletilen, henüz tamamlanmamış işler.</p>
    <ul>
      {{ range .Pending }}<li>{{ . }}</li>{{ end }}
    </ul>
  </div>
  {{ end }}

  <div class="part">
    <h2>Bölüm 2 — Çalışma saatleri</h2>
    <span class="part-sub">{{ .Client }} · {{ .TotalEntries }} süre kaydı · {{ len .HourDays }} gün</span>
  </div>

  {{ range .HourDays }}
  <section class="day">
    <div class="day-head">
      <p class="day-date">{{ .FormatDate }}</p>
      <p class="day-weekday">{{ .Weekday }}</p>
      <p class="day-total">{{ .TotalLabel }}<small>{{ .TotalSub }}</small></p>
    </div>
    <div class="hrs">
      {{ range .Entries }}
      <div class="hrs-row">
        <p class="dur">{{ duration .Duration }}</p>
        <p>{{ .Description }}{{ with .Flag }}<span class="flag">{{ . }}</span>{{ end }}</p>
      </div>
      {{ end }}
    </div>
  </section>
  {{ end }}

  <div class="grand">
    <p class="grand-label">Toplam kayıtlı süre</p>
    <p class="grand-value">{{ .TotalLabel }}<small>{{ .TotalDecimal }} saat · {{ .TotalEntries }} süre kaydı · {{ len .HourDays }} gün</small></p>
  </div>

  <div class="fee" id="fee" data-seconds="{{ .TotalSeconds }}">
    <div class="fee-amount" id="fee-amount" hidden>
      <p class="grand-label">Toplam tutar</p>
      <p class="grand-value"><span id="fee-total"></span><small id="fee-detail"></small></p>
    </div>
    <label class="fee-input">
      <span>Saatlik ücret</span>
      <input id="fee-rate" type="text" inputmode="decimal" autocomplete="off" placeholder="ör. 1.500">
      <span>₺ / saat</span>
    </label>
  </div>
  <script>
  (function () {
    var box = document.getElementById("fee");
    var rateEl = document.getElementById("fee-rate");
    var amountEl = document.getElementById("fee-amount");
    var seconds = Number(box.dataset.seconds) || 0;
    var money = new Intl.NumberFormat("tr-TR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    var hours = new Intl.NumberFormat("tr-TR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    function parseRate(s) {
      s = s.replace(/[^0-9.,]/g, "");
      if (s.indexOf(",") >= 0) s = s.replace(/\./g, "").replace(",", ".");
      else if (/^\d{1,3}(\.\d{3})+$/.test(s)) s = s.replace(/\./g, "");
      var n = parseFloat(s);
      return isFinite(n) && n > 0 ? n : 0;
    }
    function update() {
      var rate = parseRate(rateEl.value);
      box.classList.toggle("is-set", rate > 0);
      amountEl.hidden = !(rate > 0);
      if (!(rate > 0)) return;
      var total = Math.round(seconds / 3600 * rate * 100) / 100;
      document.getElementById("fee-total").textContent = money.format(total) + " ₺";
      document.getElementById("fee-detail").textContent =
        hours.format(seconds / 3600) + " saat × " + money.format(rate) + " ₺ (saniye hassasiyetinde hesaplanmıştır)";
    }
    rateEl.addEventListener("input", update);
    update();
  })();
  </script>

  {{ with .Agent }}{{ if .Days }}
  <div class="part">
    <h2>Bölüm 3 — Yapay zekâ destekli çalışma</h2>
    <span class="part-sub">{{ .Sessions }} ajan oturumu · {{ len .Days }} gün{{ if .Linked }} · {{ .Linked }} commit bir oturuma bağlı{{ end }}</span>
  </div>
  <p class="note">Bu bölüm yapay zekâ kodlama ajanlarının oturum kayıtlarından ölçülmüştür ve Bölüm 2’deki kayıtlı süreye <strong>eklenmez</strong>; aynı çalışmanın ölçülmüş görünümüdür. “Klavye başında”, istemler arasında 10 dakikadan kısa aralıklarla geçen süredir; “ajan tek başına”, ajanın yanıt beklemeden çalıştığı süredir.</p>

  {{ $cost := .ShowCost }}
  {{ range .Days }}
  <section class="day">
    <div class="day-head">
      <p class="day-date">{{ .FormatDate }}</p>
      <p class="day-weekday">{{ .Weekday }}</p>
      <p class="day-total">{{ duration .You }}<small>klavye başında</small></p>
    </div>
    <div class="hrs">
      <div class="hrs-row"><p class="dur">{{ duration .Agent }}</p><p>Ajan tek başına</p></div>
      {{ if $cost }}<div class="hrs-row"><p class="dur">{{ .CostLabel }}</p><p>Tahmini yapay zekâ maliyeti (API liste fiyatı)</p></div>{{ end }}
    </div>
  </section>
  {{ end }}

  <div class="grand">
    <p class="grand-label">Ölçülen ajan çalışması</p>
    <p class="grand-value">{{ duration .TotalYou }}<small>klavye başında · {{ duration .TotalAgent }} ajan tek başına{{ if .ShowCost }} · {{ .CostLabel }} tahmini maliyet{{ end }}</small></p>
  </div>
  {{ end }}{{ end }}

  {{ if .Reconcile }}
  <div class="reconcile">
    <h3>Süre kaydı ile commit tarihleri arasındaki farklar</h3>
    <ul>
      {{ range .Reconcile }}<li>{{ . }}</li>{{ end }}
    </ul>
  </div>
  {{ end }}

  <footer class="colophon">
    <div class="colophon-notes">
      <p>Kapsam: <code>main</code> dalı, {{ .From.Format "02.01.2006" }} 00:00 – {{ .To.Format "02.01.2006" }} arası; birleştirme (merge) commit’leri sayımın dışında tutulmuştur.</p>
      {{ if .FilesChanged }}<p>Dosya ve satır sayıları, dönemin ilk commit’i ile <code>main</code> arasındaki net farktan alınmıştır.</p>{{ end }}
      <p>Süreler kronometre kaydından alınmış, saniye hassasiyetinde toplanmıştır; ondalık saat değerleri iki basamağa yuvarlanmıştır.</p>
      <p>Hazırlayan: {{ .PreparedBy }} · Rapor tarihi {{ .GeneratedAt.Format "02.01.2006" }} · Belge {{ .DocRef }}</p>
    </div>
    <div class="maker">
      <p class="maker-label">Üreten</p>
      <a class="maker-name" href="https://github.com/tolgazorlu/btrack">btrack{{ with .ToolVersion }}<span class="maker-version">{{ . }}</span>{{ end }}</a>
      <p class="maker-tagline">Commit geçmişi ve kronometre kayıtlarından otomatik üretilmiştir.</p>
      <a class="maker-link" href="https://github.com/tolgazorlu/btrack">github.com/tolgazorlu/btrack</a>
    </div>
  </footer>

</div>
</body>
</html>
